# xAI Grok API key. Get one at https://console.x.ai
GROK_API_KEY=your_grok_api_key_here

# Optional overrides
GROK_MODEL=grok-4-latest
FLASK_PORT=5000

# DUCKDB_PATH: leave unset. The default (pipeline1.db.DEFAULT_DB_PATH)
# resolves to the shared rakaba.duckdb at the repo root regardless of the
# working directory this is launched from. A relative value here (e.g.
# "rakaba.duckdb") would instead create a SEPARATE, empty DB file relative
# to wherever the process happens to be running from - only set this if you
# deliberately want an isolated DB for testing.
# DUCKDB_PATH=rakaba.duckdb
